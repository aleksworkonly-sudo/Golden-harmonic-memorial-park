{
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/send-agent-commissions",
      "schedule": "30 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/payment-operations-admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/payment-lifecycle-admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/payment-gateway-admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/payment-cash.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/payment-review.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/payment-link.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/my-payments(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/payment-access", "destination": "/api/payments" },
    { "source": "/api/payment-submission", "destination": "/api/payments" },
    { "source": "/api/payment-review", "destination": "/api/payments" },
    { "source": "/api/payment-cash", "destination": "/api/payments" },
    { "source": "/api/payment-lifecycle", "destination": "/api/payments" },
    { "source": "/api/payment-operations", "destination": "/api/payments" },
    { "source": "/api/payment-messaging-worker", "destination": "/api/payments" },
    { "source": "/api/payment-access.js", "destination": "/api/payments" },
    { "source": "/api/payment-submission.js", "destination": "/api/payments" },
    { "source": "/api/payment-review.js", "destination": "/api/payments" },
    { "source": "/api/payment-cash.js", "destination": "/api/payments" },
    { "source": "/api/payment-lifecycle.js", "destination": "/api/payments" },
    { "source": "/api/payment-operations.js", "destination": "/api/payments" },
    { "source": "/api/payment-messaging-worker.js", "destination": "/api/payments" },
    {
      "source": "/presale",
      "destination": "/presale.html"
    },
    {
      "source": "/my-payments",
      "destination": "/my-payments.html"
    },
    {
      "source": "/receipt",
      "destination": "/receipt.html"
    }
  ]
}
